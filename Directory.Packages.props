<Project>
  <!--
    The plugin is built twice: net10.0 against Jellyfin 12.1 (also loads on later
    12.x) and net9.0 against Jellyfin 10.11.0 (loads on every 10.11.x). Built
    against the oldest of each line: Jellyfin refuses a plugin whose ABI is newer
    than itself. Other versions match what both lines use (prometheus-net 8.2.1).
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageVersion Include="Jellyfin.Model" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net9.0'">
    <PackageVersion Include="Jellyfin.Controller" Version="12.1.0" />
    <PackageVersion Include="Jellyfin.Model" Version="12.1.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="prometheus-net" Version="8.2.1" />

    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="SerilogAnalyzer" Version="0.15.0" />
    <PackageVersion Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
