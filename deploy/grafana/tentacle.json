{
  "uid": "tentacle",
  "title": "Tentacle",
  "tags": [
    "jellyfin",
    "tentacle",
    "transcoding"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "description": "Jellyfin ffmpeg jobs brokered by the Tentacle plugin: where they ran, why, how they ended, and the tentacles' health.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Jellyfin log selector",
        "type": "textbox",
        "query": "{container=\"jellyfin\"}",
        "current": {
          "text": "{container=\"jellyfin\"}",
          "value": "{container=\"jellyfin\"}"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Broker",
      "description": "Listening for shims and agents. Down (or no data) = every job runs on the server.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(tentacle_broker_up)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Placement",
      "description": "Disabled: all local. DryRun (shadow): local, decisions recorded. Active: jobs go to tentacles.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (mode) (tentacle_placement_mode) == 1",
          "legendFormat": "{{mode}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nodes taking jobs",
      "description": "Tentacles that are Ready or Degraded, plus this server when it takes jobs as a worker.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(tentacle_node_state{state=~\"Ready|Degraded\"}) or vector(0)) + (count(tentacle_server_info{role=\"worker\"}) or vector(0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tentacles not usable",
      "description": "Disconnected, Verifying, Incompatible, Draining or CoolingDown. Detect-only tentacles never take jobs and are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(tentacle_node_state{state!~\"Ready|Degraded|DetectOnly\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Transcodes by node",
      "description": "Share of the playback transcodes that ended in the selected range, by where they ran. The server (local) is named from tentacle_server_info.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "((sum by (node) (increase(tentacle_jobs_total{kind=\"Transcode\",node!=\"local\"}[$__range]))) or sum by (node) (label_replace((sum by (node) (increase(tentacle_jobs_total{kind=\"Transcode\",node=\"local\"}[$__range]))) * on() group_left(name) max by (name) (tentacle_server_info), \"node\", \"$1 (server)\", \"name\", \"(.+)\")) or ((sum by (node) (increase(tentacle_jobs_total{kind=\"Transcode\",node=\"local\"}[$__range]))) unless on() max(tentacle_server_info))) / scalar(sum(increase(tentacle_jobs_total{kind=\"Transcode\"}[$__range])))",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Failed jobs",
      "description": "error, lost or failed over the time range (any kind, any node).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(tentacle_jobs_total{outcome=~\"error|lost|failed\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Jobs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Running jobs by node",
      "description": "local = the server.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (node) (tentacle_jobs_running{node!=\"local\"})) or sum by (node) (label_replace((sum by (node) (tentacle_jobs_running{node=\"local\"})) * on() group_left(name) max by (name) (tentacle_server_info), \"node\", \"$1 (server)\", \"name\", \"(.+)\")) or ((sum by (node) (tentacle_jobs_running{node=\"local\"})) unless on() max(tentacle_server_info))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Jobs started by kind",
      "description": "Jobs per minute through the broker. ffprobe and info queries never reach it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (rate(tentacle_placements_total[$__rate_interval])) * 60",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisLabel": "jobs / min"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Where jobs ran, and why",
      "description": "least-loaded = placed on a tentacle. Local reasons: kind-local (probes, single images), path-ineligible, all-busy, background-slots-full, no-ready-tentacle, no-hardware-tentacle, attach-timeout, dry-run.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (node, reason) (increase(tentacle_placements_total{node!=\"local\"}[$__interval]))) or sum by (node, reason) (label_replace((sum by (node, reason) (increase(tentacle_placements_total{node=\"local\"}[$__interval]))) * on() group_left(name) max by (name) (tentacle_server_info), \"node\", \"$1 (server)\", \"name\", \"(.+)\")) or ((sum by (node, reason) (increase(tentacle_placements_total{node=\"local\"}[$__interval]))) unless on() max(tentacle_server_info))",
          "legendFormat": "{{node}} \u00b7 {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m"
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Job outcomes",
      "description": "ok; killed = Jellyfin stopped it (seek, stop); error = ffmpeg exited non-zero; lost = the tentacle vanished mid-job; failed = it could not start ffmpeg; exited = local job whose exit code was not captured.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (increase(tentacle_jobs_total[$__interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "killed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "exited"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lost"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m"
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Job duration p50 / p95 by kind",
      "description": "Transcodes last as long as playback (or until a seek restarts them).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (kind, le) (rate(tentacle_job_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{kind}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (kind, le) (rate(tentacle_job_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{kind}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Failures by node",
      "description": "Infrastructure failures (lost, failed) bench a tentacle after 3 in a row.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (node, outcome) (increase(tentacle_jobs_total{outcome=~\"error|lost|failed\",node!=\"local\"}[$__interval]))) or sum by (node, outcome) (label_replace((sum by (node, outcome) (increase(tentacle_jobs_total{outcome=~\"error|lost|failed\",node=\"local\"}[$__interval]))) * on() group_left(name) max by (name) (tentacle_server_info), \"node\", \"$1 (server)\", \"name\", \"(.+)\")) or ((sum by (node, outcome) (increase(tentacle_jobs_total{outcome=~\"error|lost|failed\",node=\"local\"}[$__interval]))) unless on() max(tentacle_server_info))",
          "legendFormat": "{{node}} \u00b7 {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m"
    },
    {
      "id": 15,
      "type": "row",
      "title": "Nodes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Slots used by node (share of its slots)",
      "description": "Each node's used slots over its slots, so nodes of different sizes compare: tentacles and this server when it takes jobs as a worker.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (node) (tentacle_node_slots_used{class=\"all\",node!=\"local\"}) / sum by (node) (tentacle_node_slots{class=\"all\",node!=\"local\"} > 0)) or sum by (node) (label_replace((sum by (node) (tentacle_node_slots_used{class=\"all\",node=\"local\"}) / sum by (node) (tentacle_node_slots{class=\"all\",node=\"local\"} > 0)) * on() group_left(name) max by (name) (tentacle_server_info), \"node\", \"$1 (server)\", \"name\", \"(.+)\")) or ((sum by (node) (tentacle_node_slots_used{class=\"all\",node=\"local\"}) / sum by (node) (tentacle_node_slots{class=\"all\",node=\"local\"} > 0)) unless on() max(tentacle_server_info))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Nodes now",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "description": "Each tentacle and this server (marked \"(server)\"): state, slots, versions. The server is Ready when it takes jobs as a worker, Backup only when it runs only what no tentacle can take.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (node, state) (tentacle_node_state) == 1 or max by (node, state) (label_replace(label_replace(tentacle_server_info, \"node\", \"$1 (server)\", \"name\", \"(.+)\"), \"state\", \"$1\", \"role\", \"(.+)\"))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(max by (node, class) (tentacle_node_slots{class=\"all\",node!=\"local\"})) or sum by (node, class) (label_replace((max by (node, class) (tentacle_node_slots{class=\"all\",node=\"local\"})) * on() group_left(name) max by (name) (tentacle_server_info), \"node\", \"$1 (server)\", \"name\", \"(.+)\")) or ((max by (node, class) (tentacle_node_slots{class=\"all\",node=\"local\"})) unless on() max(tentacle_server_info))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(max by (node, class) (tentacle_node_slots{class=\"background\",node!=\"local\"})) or sum by (node, class) (label_replace((max by (node, class) (tentacle_node_slots{class=\"background\",node=\"local\"})) * on() group_left(name) max by (name) (tentacle_server_info), \"node\", \"$1 (server)\", \"name\", \"(.+)\")) or ((max by (node, class) (tentacle_node_slots{class=\"background\",node=\"local\"})) unless on() max(tentacle_server_info))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (node, agent_version, ffmpeg_version) (tentacle_node_info)",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Value #A": true,
              "Value #D": true,
              "class 1": true,
              "class 2": true,
              "class": true
            },
            "renameByName": {
              "node": "Node",
              "state": "State",
              "Value #B": "Slots",
              "Value #C": "Background slots",
              "agent_version": "Agent",
              "ffmpeg_version": "ffmpeg"
            },
            "indexByName": {
              "node": 0,
              "state": 1,
              "Value #B": 2,
              "Value #C": 3,
              "agent_version": 4,
              "ffmpeg_version": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Ready": {
                        "color": "green",
                        "index": 0
                      },
                      "Degraded": {
                        "color": "yellow",
                        "index": 1
                      },
                      "Verifying": {
                        "color": "blue",
                        "index": 2
                      },
                      "Draining": {
                        "color": "text",
                        "index": 3
                      },
                      "CoolingDown": {
                        "color": "orange",
                        "index": 4
                      },
                      "Incompatible": {
                        "color": "red",
                        "index": 5
                      },
                      "Disconnected": {
                        "color": "red",
                        "index": 6
                      },
                      "DetectOnly": {
                        "color": "blue",
                        "index": 7
                      },
                      "worker": {
                        "text": "Ready",
                        "color": "green",
                        "index": 8
                      },
                      "backup": {
                        "text": "Backup only",
                        "color": "blue",
                        "index": 9
                      },
                      "never": {
                        "text": "No transcoding",
                        "color": "text",
                        "index": 10
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Node"
          }
        ]
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Failing checks",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "description": "From each tentacle's last verification. Required failures make it Degraded; optional ones (libraries, concat, fonts) only keep jobs that need them local. Details on the plugin's dashboard page.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tentacle_node_check == 0",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "endpoint": true,
              "container": true
            },
            "renameByName": {
              "node": "Tentacle",
              "check": "Check",
              "required": "Required"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Job log",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "logs",
      "title": "Jobs (tentacle_job lines)",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "description": "One line per job when it ends, in logfmt: job, kind, node, reason (with the path for path-ineligible), would_run_on, outcome, exit, duration_ms, nice, user (playback only) and item.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "${logs} |= \"tentacle_job\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
